# --- App URLs ---
# App/backend origin, for checkout success, auth links and portal redirects.
PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Marketing origin, for checkout cancel redirects when checkout starts from the static site.
PUBLIC_MARKETING_SITE_URL=http://localhost:8080
NEXT_PUBLIC_MARKETING_SITE_URL=http://localhost:8080

# --- Supabase ---
# Public anon key is safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only URL alias (defaults to NEXT_PUBLIC_SUPABASE_URL when unset).
SUPABASE_URL=

# Service role key must NEVER be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Prisma) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Postmark (transactional email) ---
# Used for post-checkout magic-link delivery.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
