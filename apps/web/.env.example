# --- App URLs ---
# Canonical app/backend origin. Required as HTTPS in production for auth email
# redirects; security-sensitive code never trusts Host/forwarded headers.
PUBLIC_SITE_URL=http://localhost:3000
# Browser-visible convenience URL only; not accepted for secure email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Marketing origin, for checkout cancel redirects when checkout starts from the static site.
PUBLIC_MARKETING_SITE_URL=http://localhost:8080
NEXT_PUBLIC_MARKETING_SITE_URL=http://localhost:8080

# --- Supabase ---
# Public anon key is safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only URL alias (defaults to NEXT_PUBLIC_SUPABASE_URL when unset).
SUPABASE_URL=

# Service role key must NEVER be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Prisma) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Postmark (transactional email) ---
# Used for checkout/auth and project lifecycle transactional email.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
# Comma-separated recipients for admin lifecycle notifications (for example,
# new-project and client-feedback alerts).
ADMIN_EMAILS=
