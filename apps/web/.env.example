# --- App URLs ---
# Canonical app/backend origin. Required as HTTPS in production for auth email
# redirects; security-sensitive code never trusts Host/forwarded headers.
PUBLIC_SITE_URL=http://localhost:3000
# Browser-visible convenience URL only; not accepted for secure email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Marketing origin, for checkout cancel redirects when checkout starts from the static site.
PUBLIC_MARKETING_SITE_URL=http://localhost:8080
NEXT_PUBLIC_MARKETING_SITE_URL=http://localhost:8080

# --- Better Auth (server only) ---
# Generate a cryptographically random secret with at least 32 characters.
# Never expose it through NEXT_PUBLIC_*; canonical PUBLIC_SITE_URL above is required.
BETTER_AUTH_SECRET=

# --- Database (Prisma) ---
# Runtime DML-only role. Never point to old Supabase host/pooler.
DATABASE_URL=postgresql://lf_runtime:PASSWORD@HOST:5432/DB?schema=public
# Migrations: required separate owner role; same explicit host/port/database.
# No DATABASE_URL fallback. Never deploy these credentials to the runtime service.
DIRECT_URL=postgresql://lf_migration:PASSWORD@HOST:5432/DB?schema=public

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Postmark (transactional email) ---
# Used for checkout/auth and project lifecycle transactional email.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
# Comma-separated recipients for admin lifecycle notifications (for example,
# new-project and client-feedback alerts).
ADMIN_NOTIFICATION_EMAILS=

# --- Private Cloudflare R2 (server-only; no bucket creation by this app) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CONCEPTS_BUCKET=
R2_FINAL_DELIVERABLES_BUCKET=
# Optional jurisdiction: eu or fedramp; empty means default account endpoint.
R2_JURISDICTION=
