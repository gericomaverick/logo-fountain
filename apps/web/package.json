{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "prisma generate",
    "start": "node scripts/auth-proxy-preflight.mjs --production && next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "security:check": "node scripts/security-check.mjs",
    "predeploy:check": "npm run security:check && npm run lint && npm run typecheck",
    "local:run": "node scripts/local-run.mjs",
    "test:postgres": "node scripts/isolated-postgres-test.mjs",
    "db:migrate": "prisma migrate deploy",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.10",
    "next": "16.4.1",
    "pg": "^8.19.0",
    "prisma": "7.10.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "server-only": "^0.0.1",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-react-hooks": "7.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
