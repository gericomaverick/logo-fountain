#!/bin/sh
# The Laravel quality gate: the AGENTS.md drift check (host, story 1.2), then Pint, Larastan level 9
# and Pest in the app container (story 1.1a). Extra args go to Pest.
set -e
"$(dirname "$0")/check-agents-guide"
c="docker compose -f $(dirname "$0")/../compose.yaml exec -T app"
$c vendor/bin/pint --test
$c vendor/bin/phpstan analyse --no-progress --memory-limit=1G
$c vendor/bin/pest "$@"
