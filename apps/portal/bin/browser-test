#!/bin/sh
# L7/L7a browser checks (tests/browser) in the pinned Playwright image against a running
# portal stack (docker compose up). Uses the host network, so PORTAL_HTTP_PORT must be the
# stack's port (default 8080). The host is localhost, not 127.0.0.1: the Vite dev server only
# allows CORS (module scripts, fonts) from the APP_URL host. Extra arguments go to `playwright test`.
set -e
dir=$(cd "$(dirname "$0")/.." && pwd)
port=${PORTAL_HTTP_PORT:-8080}
docker run --rm --network host --ipc host -u "$(id -u):$(id -g)" -e HOME=/tmp \
    -e PORTAL_BASE_URL="http://localhost:$port" -e CI \
    -v "$dir:/app" -w /app mcr.microsoft.com/playwright:v1.64.1-noble \
    npx playwright test "$@"
