#!/bin/sh
# Front-end checks in a throwaway Node 24 container (no host Node needed), stories 1.7 and 1.9:
# the L7b design lint, ESLint (eslint.config.js), the node:test unit tests (tokens, contrast, lint
# rules, polling, media...) and tsc. CI runs this in the portal.yml ui job. Browser checks: bin/browser-test.
# node_modules is (re)installed when it's missing or older than package-lock.json.
set -e
dir=$(cd "$(dirname "$0")/.." && pwd)
docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e NPM_CONFIG_UPDATE_NOTIFIER=false \
    -v "$dir:/app" -w /app node:24-bookworm-slim \
    sh -c '[ node_modules/.package-lock.json -nt package-lock.json ] || npm ci --no-fund --no-audit; npm run -s lint:design && npm run -s lint && npm run -s test:unit && npm run -s typecheck'
