APP_NAME="Logo Fountain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev only (compose.yaml). Runtime role = DML only; migrate role = schema owner (ADR-013).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=portal
DB_USERNAME=portal_runtime
DB_PASSWORD=dev-only-runtime
DB_MIGRATE_USERNAME=portal_migrate
DB_MIGRATE_PASSWORD=dev-only-migrate

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="portal@logofountain.test"
MAIL_FROM_NAME="${APP_NAME}"
# Production (story 2.7, ADR-018): MAIL_MAILER=postmark with Next's names, so the env does not change on cutover.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=


VITE_APP_NAME="${APP_NAME}"

# Portal settings (O-07, config/portal.php, story 1.3).
# PUBLIC_SITE_URL: canonical origin, https in production. Leave it empty locally: the loopback
# request origin is used instead, so any local port works.
PUBLIC_SITE_URL=
PUBLIC_MARKETING_SITE_URL=
# Set exactly one (ADR-010, X-05). Production: cf-connecting-ip behind Cloudflare. Dev: the same; the
# dev nginx overwrites it with the socket peer (docker/nginx/default.conf), as Cloudflare does.
AUTH_CLIENT_IP_HEADER=cf-connecting-ip
AUTH_TRUSTED_PROXY_HOPS=
ADMIN_NOTIFICATION_EMAILS=
EMAIL_LOGO_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test seam only (ADR-014): the stripe-fake base URL. Leave unset for Stripe itself. Never a live key in dev or CI.
STRIPE_API_BASE=
# Dev-only SeaweedFS credentials and buckets (compose.yaml); production uses the R2 values.
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=dev-only-access-key
R2_SECRET_ACCESS_KEY=dev-only-secret-key
R2_CONCEPTS_BUCKET=portal-concepts
R2_FINAL_DELIVERABLES_BUCKET=portal-finals
R2_JURISDICTION=
# Dev/test seam: the local SeaweedFS (path-style). Empty in production (Cloudflare R2).
R2_ENDPOINT=http://seaweedfs:8333
