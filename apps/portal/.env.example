APP_NAME="Logo Fountain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev only (compose.yaml). Runtime role = DML only; migrate role = schema owner (ADR-013).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=portal
DB_USERNAME=portal_runtime
DB_PASSWORD=dev-only-runtime
DB_MIGRATE_USERNAME=portal_migrate
DB_MIGRATE_PASSWORD=dev-only-migrate

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="portal@logofountain.test"
MAIL_FROM_NAME="${APP_NAME}"

# Local S3 stand-in (SeaweedFS) for R2. Dev-only credentials.
AWS_ACCESS_KEY_ID=dev-only-access-key
AWS_SECRET_ACCESS_KEY=dev-only-secret-key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=portal-dev
AWS_ENDPOINT=http://seaweedfs:8333
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
