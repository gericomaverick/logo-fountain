{% import 'partials/icons.njk' as icon %}
<header class="nav" id="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="{{ site.name }} home">
      {% include 'partials/logo-mark.njk' %}
      <span>{{ site.name }}</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {% for item in site.navigation %}<a class="nav-link" href="{{ item.url }}">{{ item.text }}</a>{% endfor %}
      <a class="nav-cta" href="{{ site.cta.url }}">{{ site.cta.text }} {{ icon.arrow() }}</a>
    </nav>
  </div>
</header>
