<section class="section section--paper"{% if block.id %} id="{{ block.id }}"{% endif %}>
  <div class="container">
    <div class="about-grid">
      <div>
        <div class="eyebrow">{{ block.eyebrow }}</div>
        <h2 class="display" style="margin-top:18px;margin-bottom:24px">{{ block.title | safe }}</h2>
        {{ block.content | markdown | safe }}
        <div class="signature">{{ block.signature }}</div>
      </div>
      <div class="about-card">
        <div class="eyebrow">{{ block.card.eyebrow }}</div>
        <h3 class="serif" style="font-size:30px;margin:16px 0 8px">{{ block.card.title }}</h3>
        <p style="color:var(--ink-60);font-size:16px;margin:0">{{ block.card.content }}</p>
        <div class="stat-row">{% for stat in block.card.stats %}<div class="stat"><span class="num">{{ stat.value }}</span><span class="lbl">{{ stat.label }}</span></div>{% endfor %}</div>
      </div>
    </div>
  </div>
</section>
