{
  "name": "logo-fountain-parity",
  "private": true,
  "type": "module",
  "description": "Black-box parity suite that runs against the Next.js app (apps/web) or the Laravel app (apps/portal).",
  "scripts": {
    "test": "playwright test",
    "check": "node scripts/check-structure.mjs",
    "selftest": "node scripts/selftest.mjs",
    "infra:up": "docker compose -f infra/docker-compose.test.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.test.yml down -v --remove-orphans",
    "infra:probe": "node infra/probe.mjs",
    "coverage": "node scripts/coverage.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "stripe": "20.4.0"
  }
}
